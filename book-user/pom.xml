<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>

	<groupId>projeto01-ms</groupId>
	<artifactId>book-user</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>book-user</name>
	<description>User Service — Bookstore Microservices</description>

	<properties>
		<java.version>21</java.version>
		<!-- versão centralizada do jjwt para não repetir em cada artefato -->
		<jjwt.version>0.12.6</jjwt.version>
	</properties>

	<dependencies>

		<!-- ===== WEB ===== -->
		<!--
			spring-boot-starter-web inclui: Spring MVC, Jackson, Tomcat embutido
			e já disponibiliza RestClient (substitui RestTemplate).
			O starter "spring-boot-starter-restclient" que estava no pom não existe
			oficialmente — esta dependência o substitui corretamente.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Validação de campos nos DTOs (@NotBlank, @Email, @Size, etc.) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- ===== PERSISTÊNCIA ===== -->
		<!-- JPA + Hibernate -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Driver MySQL (runtime — não precisa em compile) -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ===== SEGURANÇA ===== -->
		<!-- Spring Security (autenticação, autorização, filtros HTTP) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!--
			JWT — três artefatos obrigatórios do jjwt 0.12.x:
			  - jjwt-api    : interfaces públicas que seu código usa em compile time
			  - jjwt-impl   : implementação interna; runtime basta
			  - jjwt-jackson: serialização/deserialização JSON dos claims; runtime basta
		-->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- ===== UTILITÁRIOS ===== -->
		<!-- Lombok — geração de código em compile time (getters, construtores, etc.) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- DevTools — restart automático em dev; nunca vai para produção -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- ===== TESTES ===== -->
		<!--
			spring-boot-starter-test já inclui tudo:
			  - JUnit 5, Mockito, AssertJ, MockMvc, DataJpaTest, etc.
			Os três starters de teste que estavam no pom não existem —
			este único os substitui todos.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Testes de segurança: @WithMockUser, SecurityMockMvcRequestPostProcessors, etc. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- H2 em memória para testes de repositório sem depender do MySQL real -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>

			<!-- Plugin principal do Spring Boot: empacota o fat-jar executável -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!--
						Exclui Lombok do fat-jar — ele só é necessário em compile time.
						Sem isso, o jar fica maior sem nenhum benefício.
					-->
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!--
				Compiler plugin — configura Java 21 e o annotation processor do Lombok.
				Com spring-boot-starter-parent herdado, não é necessário declarar a versão
				do plugin explicitamente; apenas a configuração do annotationProcessorPaths.
				As duas execuções (compile + testCompile) foram unificadas: basta uma
				configuração no nível do plugin, que o Maven aplica a ambas as fases.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

		</plugins>
	</build>

</project>